<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Organizer.Application.ViewModels"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:pref="using:Organizer.Organizer.Application.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="680"
             x:Class="Organizer.Organizer.Application.Views.PreferencesView"
             x:DataType="vm:PreferencesViewModel">

    <UserControl.Styles>
        <Style Selector="Border.section-card">
            <Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FloatingBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="13" />
        </Style>

        <Style Selector="Border.section-head">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="0 0 0 1" />
            <Setter Property="Padding" Value="18 14 18 12" />
        </Style>

        <Style Selector="Border.preference-row">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="0 0 0 1" />
            <Setter Property="Padding" Value="18 13" />
        </Style>

        <Style Selector="Border.preference-row.last">
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="Border.preference-row:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>

        <Style Selector="Border.preference-tile">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="0 0 1 0" />
            <Setter Property="Padding" Value="18 13" />
        </Style>

        <Style Selector="Border.preference-tile.last">
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="Border.preference-tile:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>

        <Style Selector="ComboBox.preference-select">
            <Setter Property="MinWidth" Value="160" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10 0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="ComboBox.preference-select:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource FloatingBorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceSoftAltBrush}" />
        </Style>

        <Style Selector="ComboBox.preference-select:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
        </Style>

        <Style Selector="ComboBox.preference-select TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style Selector="ComboBox.preference-select ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        </Style>

        <Style Selector="ComboBox.preference-select ComboBoxItem:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>

        <Style Selector="ComboBox.preference-select ComboBoxItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>

        <Style Selector="TextBlock.section-title">
            <Setter Property="Foreground" Value="{DynamicResource AccentSoftTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="TextBlock.section-subtitle">
            <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="TextBlock.row-title">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="TextBlock.row-description">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="Button.settings-tab">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14 7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.settings-tab:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceSoftAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style Selector="Button.settings-tab.selected">
            <Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FloatingBorderBrush}" />
        </Style>

        <Style Selector="Button.settings-tab ic|FluentIcon">
            <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
        </Style>

        <Style Selector="Button.settings-tab.selected ic|FluentIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style Selector="Button.settings-tab.selected TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style Selector="Button.theme-option">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="11 6" />
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.theme-option:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceSoftAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style Selector="Button.theme-option.selected">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentSoftTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
        </Style>

        <Style Selector="Button.theme-option ic|FluentIcon">
            <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
        </Style>

        <Style Selector="Button.theme-option TextBlock">
            <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style Selector="StackPanel.section-heading ic|FluentIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
        </Style>

        <Style Selector="Slider">
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Slider:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        </Style>

        <Style Selector="ToggleSwitch">
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.backup-action">
            <Setter Property="MinHeight" Value="64" />
            <Setter Property="Padding" Value="14 11" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentSoftTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FloatingBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.backup-action:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentSoftTextBrush}" />
        </Style>

        <Style Selector="Button.backup-action.primary">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentSoftTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
        </Style>

        <Style Selector="Button.backup-action.danger">
            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DangerSoftTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
        </Style>

        <Style Selector="Button.backup-action:disabled">
            <Setter Property="Background" Value="{DynamicResource SurfaceSoftAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}" />
        </Style>

        <Style Selector="Button.backup-action ic|FluentIcon">
            <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
        </Style>

        <Style Selector="TextBlock.backup-action-title">
            <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="TextBlock.backup-action-desc">
            <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="Grid.backup-actions-grid">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style Selector="Border.backup-stat-cell">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="0 0 1 0" />
            <Setter Property="Padding" Value="18 14" />
        </Style>

        <Style Selector="Border.backup-stat-cell.last">
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="TextBlock.backup-stat-label">
            <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style Selector="TextBlock.backup-stat-value">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style Selector="Border.backup-field-row">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="0 0 0 1" />
            <Setter Property="Padding" Value="18 11" />
        </Style>

        <Style Selector="Border.backup-field-row.last">
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="TextBlock.backup-field-label">
            <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style Selector="Border.cloud-status-dot">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Border.cloud-status-dot.connected">
            <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
        </Style>

        <Style Selector="Border.cloud-status-dot.disconnected">
            <Setter Property="Background" Value="{DynamicResource TextSubtleBrush}" />
        </Style>

        <Style Selector="TextBlock.cloud-status-text.connected">
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
        </Style>

        <Style Selector="TextBlock.cloud-status-text.disconnected">
            <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
        </Style>

        <Style Selector="TextBlock.info-value">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="Border.about-hero">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="0 0 0 1" />
            <Setter Property="Padding" Value="22 20" />
        </Style>

        <Style Selector="Border.about-icon">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
        </Style>

        <Style Selector="Border.about-version-badge">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10 4" />
        </Style>

        <Style Selector="Border.about-stat-cell">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="0 0 1 1" />
            <Setter Property="Padding" Value="20 16" />
        </Style>

        <Style Selector="Border.about-stat-cell.last">
            <Setter Property="BorderThickness" Value="0 0 0 1" />
        </Style>

        <Style Selector="TextBlock.about-label">
            <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style Selector="TextBlock.about-stat-value">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LineHeight" Value="24" />
        </Style>

        <Style Selector="TextBlock.about-stat-sub">
            <Setter Property="Foreground" Value="{DynamicResource AccentSoftTextBrush}" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style Selector="Border.about-tech-section">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="0 0 0 1" />
            <Setter Property="Padding" Value="20 14" />
        </Style>

        <Style Selector="Border.about-chip">
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FloatingBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="11 5" />
        </Style>

        <Style Selector="Border.about-link">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="0 0 1 1" />
            <Setter Property="Padding" Value="18 13" />
        </Style>

        <Style Selector="Border.about-link.right">
            <Setter Property="BorderThickness" Value="0 0 0 1" />
        </Style>

        <Style Selector="Border.about-link.bottom">
            <Setter Property="BorderThickness" Value="0 0 1 0" />
        </Style>

        <Style Selector="Border.about-link.right.bottom">
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="TextBlock.about-link-title">
            <Setter Property="Foreground" Value="{DynamicResource AccentSoftTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="TextBlock.about-link-sub">
            <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="Border.autosave-hint">
            <Setter Property="Padding" Value="24 10" />
        </Style>
    </UserControl.Styles>

    <Grid Background="{DynamicResource AppBackgroundBrush}"
          RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Margin="24 20 24 0"
                    Spacing="3">
            <TextBlock Text="{DynamicResource Loc.Preferences.Title}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="15"
                       FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Loc.Preferences.Subtitle}"
                       Foreground="{DynamicResource TextSubtleBrush}"
                       FontSize="12" />
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Margin="24 14 24 0"
                    Orientation="Horizontal"
                    Spacing="4">
            <Button Classes="settings-tab"
                    Classes.selected="{Binding IsGeneralSelected}"
                    Click="OnGeneralSettingsClick">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <ic:FluentIcon Icon="Settings"
                                   IconVariant="Regular"
                                   IconSize="Size16" />
                    <TextBlock Text="{DynamicResource Loc.Preferences.TabSettings}" />
                </StackPanel>
            </Button>
            <Button Classes="settings-tab"
                    Classes.selected="{Binding IsDataBackupSelected}"
                    Click="OnDataBackupClick">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <ic:FluentIcon Icon="Database"
                                   IconVariant="Regular"
                                   IconSize="Size16" />
                    <TextBlock Text="{DynamicResource Loc.Preferences.TabDataBackup}" />
                </StackPanel>
            </Button>
            <Button Classes="settings-tab"
                    Classes.selected="{Binding IsAboutSelected}"
                    Click="OnAboutClick">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <ic:FluentIcon Icon="Info"
                                   IconVariant="Regular"
                                   IconSize="Size16" />
                    <TextBlock Text="{DynamicResource Loc.Preferences.TabAbout}" />
                </StackPanel>
            </Button>
        </StackPanel>

        <ScrollViewer Grid.Row="2"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Margin="0 16 0 0">
            <Grid Margin="24 0 24 28">
                <pref:PreferencesGeneralView IsVisible="{Binding IsGeneralSectionVisible}" />
                <pref:PreferencesBackupView IsVisible="{Binding IsDataBackupSectionVisible}" />
                <pref:PreferencesAboutView IsVisible="{Binding IsAboutSectionVisible}" />
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="3"
                Classes="autosave-hint">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="6"
                        Height="6"
                        Background="{DynamicResource SuccessBrush}"
                        CornerRadius="3"
                        VerticalAlignment="Center" />
                <TextBlock Text="{DynamicResource Loc.Common.SaveAuto}"
                           Foreground="{DynamicResource SuccessBrush}"
                           FontSize="11"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

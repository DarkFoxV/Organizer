<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:conv="using:Organizer.Application.Converters"
             xmlns:vm="using:Organizer.Application.ViewModels"
             xmlns:cvm="using:Organizer.Application.ViewModels.Components"
             x:Class="Organizer.Application.Views.ManageTagsView"
             x:DataType="vm:ManageTagsViewModel">

    <UserControl.Styles>
        <Style Selector="Border.float-card">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
        </Style>

        <Style Selector="TextBlock.page-title">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>

        <Style Selector="TextBlock.stat-label">
            <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="TextBlock.stat-value">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>

        <Style Selector="TextBlock.stat-sub">
            <Setter Property="Foreground" Value="{DynamicResource AccentSoftTextBrush}" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style Selector="TextBlock.section-label">
            <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="TextBlock.section-info">
            <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style Selector="TextBox.filter-input">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBox.create-input">
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12 8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryBrush}" />
        </Style>

        <Style Selector="TextBox.create-input:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
        </Style>

        <Style Selector="TextBox.field">
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12 8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryBrush}" />
        </Style>

        <Style Selector="ComboBox.color-picker">
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12 0" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinWidth" Value="126" />
        </Style>

        <Style Selector="Button.btn">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14 0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>

        <Style Selector="Button.btn-ghost">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Button.btn-ghost:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentSoftTextBrush}" />
        </Style>

        <Style Selector="Button.icon-btn">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.icon-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style Selector="Button ic|FluentIcon">
            <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
        </Style>

        <Style Selector="ic|FluentIcon.muted-icon">
            <Setter Property="IconVariant" Value="Regular" />
            <Setter Property="IconSize" Value="Size16" />
            <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Grid Background="{DynamicResource AppBackgroundBrush}">

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="20 20 20 28"
                        Spacing="16"
                        MaxWidth="1040"
                        HorizontalAlignment="Stretch">

                <Grid>
                    <TextBlock Classes="page-title"
                               Text="{DynamicResource Loc.Tags.ManageTitle}"
                               VerticalAlignment="Center" />
                </Grid>

                <Grid ColumnDefinitions="*,*,*"
                      ColumnSpacing="10">
                    <Border Classes="float-card"
                            Padding="16 14">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="stat-label"
                                       Text="{DynamicResource Loc.Tags.StatTotal}" />
                            <TextBlock Classes="stat-value"
                                       Text="{Binding TagCount}" />
                            <TextBlock Classes="stat-sub"
                                       Text="{Binding ActiveTagSummaryText}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Classes="float-card"
                            Padding="16 14">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="stat-label"
                                       Text="{DynamicResource Loc.Tags.StatTaggedImages}" />
                            <TextBlock Classes="stat-value"
                                       Text="{Binding TaggedImageCount}" />
                            <TextBlock Classes="stat-sub"
                                       Foreground="{DynamicResource SuccessTextBrush}"
                                       Text="{Binding CoverageText}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Classes="float-card"
                            Padding="16 14">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="stat-label"
                                       Text="{DynamicResource Loc.Tags.StatUnused}" />
                            <TextBlock Classes="stat-value"
                                       Text="{Binding UnusedTagCount}" />
                            <TextBlock Classes="stat-sub"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="{Binding UnusedTagSummaryText}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Classes="float-card"
                        CornerRadius="13"
                        Padding="16 14">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                          ColumnSpacing="10"
                          VerticalAlignment="Center">
                        <ic:FluentIcon Classes="muted-icon"
                                       Icon="Tag" />

                        <TextBox Grid.Column="1"
                                 Classes="create-input"
                                 Text="{Binding NewTagName}"
                                 PlaceholderText="{DynamicResource Loc.Tags.NamePlaceholder}" />

                        <ComboBox Grid.Column="2"
                                  Classes="color-picker"
                                  ItemsSource="{Binding ColorOptions}"
                                  SelectedItem="{Binding NewTagColor}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="12"
                                                Height="12"
                                                CornerRadius="3"
                                                Background="{Binding Converter={x:Static conv:TagColorBrushConverter.Instance}}"
                                                BorderBrush="{DynamicResource FloatingBorderBrush}"
                                                BorderThickness="1"
                                                VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button Grid.Column="3"
                                Classes="btn btn-primary"
                                Command="{Binding CreateTagCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:FluentIcon Icon="Add"
                                               IconVariant="Regular"
                                               IconSize="Size16"
                                               VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Loc.Tags.Create}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="section-label"
                               Text="{Binding TagSectionTitle}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Classes="section-info"
                               Text="{DynamicResource Loc.Tags.SortedByUsage}"
                               VerticalAlignment="Center" />
                </Grid>

                <Border Classes="float-card"
                        IsVisible="{Binding !HasTags}"
                        Padding="32">
                    <StackPanel HorizontalAlignment="Center"
                                Spacing="10">
                        <ic:FluentIcon Icon="TagAdd"
                                       IconVariant="Regular"
                                       IconSize="Size48"
                                       Foreground="{DynamicResource TextSubtleBrush}"
                                       HorizontalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Loc.Tags.EmptyTitle}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Loc.Tags.EmptySubtitle}"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Classes="float-card"
                        IsVisible="{Binding ShowFilterEmpty}"
                        Padding="24"
                        HorizontalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Center"
                                Spacing="8">
                        <TextBlock Text="{DynamicResource Loc.Tags.FilterEmptyTitle}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Loc.Tags.FilterEmptySubtitle}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding VisibleTags}"
                              IsVisible="{Binding HasVisibleTags}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="cvm:TagRowViewModel">
                            <Border Classes="float-card"
                                    CornerRadius="11"
                                    Padding="14 11"
                                    Margin="0 0 0 6">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                                      ColumnSpacing="12"
                                      VerticalAlignment="Center">
                                    <Border Width="10"
                                            Height="10"
                                            CornerRadius="5"
                                            Background="{Binding ColorHex}"
                                            VerticalAlignment="Center" />

                                    <Panel Grid.Column="1"
                                           VerticalAlignment="Center">
                                        <StackPanel IsVisible="{Binding IsNotEditing}"
                                                    Spacing="1">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="13"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding UsageText}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSubtleBrush}" />
                                        </StackPanel>

                                        <Grid IsVisible="{Binding IsEditing}"
                                              ColumnDefinitions="*,Auto"
                                              ColumnSpacing="10">
                                            <TextBox Grid.Column="0"
                                                     Classes="field"
                                                     Text="{Binding EditName}" />
                                            <ComboBox Grid.Column="1"
                                                      Classes="color-picker"
                                                      ItemsSource="{Binding $parent[UserControl].((vm:ManageTagsViewModel)DataContext).ColorOptions}"
                                                      SelectedItem="{Binding EditColor}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <Border Width="12"
                                                                    Height="12"
                                                                    CornerRadius="3"
                                                                    Background="{Binding Converter={x:Static conv:TagColorBrushConverter.Instance}}"
                                                                    BorderBrush="{DynamicResource FloatingBorderBrush}"
                                                                    BorderThickness="1"
                                                                    VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding}"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </Grid>
                                    </Panel>

                                    <Border Grid.Column="2"
                                            Width="90"
                                            Height="3"
                                            Background="{DynamicResource SurfaceSoftAltBrush}"
                                            CornerRadius="2"
                                            ClipToBounds="True"
                                            VerticalAlignment="Center">
                                        <Border Width="{Binding UsageBarWidth}"
                                                HorizontalAlignment="Left"
                                                Background="{Binding ColorHex}"
                                                CornerRadius="2" />
                                    </Border>

                                    <Panel Grid.Column="3"
                                           VerticalAlignment="Center">
                                        <Button IsVisible="{Binding IsNotEditing}"
                                                Classes="icon-btn"
                                                ToolTip.Tip="{DynamicResource Loc.Tags.ActionsMenu}">
                                            <ic:FluentIcon Icon="MoreVertical"
                                                           IconVariant="Regular"
                                                           IconSize="Size20" />
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuItem Header="{DynamicResource Loc.Tags.Edit}"
                                                              Command="{Binding StartEditCommand}" />
                                                    <MenuItem Header="{DynamicResource Loc.Tags.Delete}"
                                                              Command="{Binding DeleteCommand}" />
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>

                                        <StackPanel IsVisible="{Binding IsEditing}"
                                                    Orientation="Horizontal"
                                                    Spacing="8">
                                            <Button Classes="btn btn-primary"
                                                    Command="{Binding SaveCommand}">
                                                <TextBlock Text="{DynamicResource Loc.Tags.Save}" />
                                            </Button>
                                            <Button Classes="btn btn-ghost"
                                                    Command="{Binding CancelEditCommand}">
                                                <TextBlock Text="{DynamicResource Loc.Tags.Cancel}" />
                                            </Button>
                                        </StackPanel>
                                    </Panel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>

        </ScrollViewer>

        <Border ZIndex="50"
                IsVisible="{Binding IsDeleteConfirmationVisible}"
                Background="{DynamicResource OverlayBrush}">
            <Grid HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="430"
                        Background="{DynamicResource OverlayCardBrush}"
                        BorderBrush="{DynamicResource FloatingBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="22"
                        BoxShadow="0 0 0 0 Transparent">
                    <StackPanel Spacing="18">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding DeleteConfirmationTitle}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="20"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding DeleteConfirmationUsageText}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="13"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{DynamicResource Loc.Tags.DeleteConfirmImpact}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="13"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="10">
                            <Button Classes="btn btn-ghost"
                                    Command="{Binding CancelDeleteCommand}">
                                <TextBlock Text="{DynamicResource Loc.Common.Cancel}" />
                            </Button>
                            <Button Classes="btn btn-danger"
                                    Command="{Binding ConfirmDeleteCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ic:FluentIcon Icon="Delete"
                                                   IconVariant="Regular"
                                                   IconSize="Size20"
                                                   VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource Loc.Common.Delete}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

    </Grid>

</UserControl>

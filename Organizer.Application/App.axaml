<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Organizer.Application.App"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush">#080b10</SolidColorBrush>
        <SolidColorBrush x:Key="SurfaceBrush">#0d1219</SolidColorBrush>
        <SolidColorBrush x:Key="SurfaceAltBrush">#080b10</SolidColorBrush>
        <SolidColorBrush x:Key="SurfaceSoftBrush">#0d1219</SolidColorBrush>
        <SolidColorBrush x:Key="SurfaceSoftAltBrush">#111822</SolidColorBrush>
        <SolidColorBrush x:Key="BorderBrushColor">#1a2030</SolidColorBrush>
        <SolidColorBrush x:Key="FloatingBorderBrush">#1a2030</SolidColorBrush>
        <SolidColorBrush x:Key="TextPrimaryBrush">#dde3ed</SolidColorBrush>
        <SolidColorBrush x:Key="TextMutedBrush">#7a8ca8</SolidColorBrush>
        <SolidColorBrush x:Key="TextSubtleBrush">#3e4b61</SolidColorBrush>
        <SolidColorBrush x:Key="PrimaryBrush">#1544a8</SolidColorBrush>
        <SolidColorBrush x:Key="PrimaryHoverBrush">#1a52c8</SolidColorBrush>
        <SolidColorBrush x:Key="SuccessBrush">#16a34a</SolidColorBrush>
        <SolidColorBrush x:Key="SuccessHoverBrush">#15803d</SolidColorBrush>
        <SolidColorBrush x:Key="DangerBrush">#dc2626</SolidColorBrush>
        <SolidColorBrush x:Key="DangerHoverBrush">#b91c1c</SolidColorBrush>
        <SolidColorBrush x:Key="DangerSoftBrush">#2d1515</SolidColorBrush>
        <SolidColorBrush x:Key="DangerSoftTextBrush">#f87171</SolidColorBrush>
        <SolidColorBrush x:Key="WarningTextBrush">#fb923c</SolidColorBrush>
        <SolidColorBrush x:Key="SuccessTextBrush">#4ade80</SolidColorBrush>
        <SolidColorBrush x:Key="AccentSoftBrush">#10151e</SolidColorBrush>
        <SolidColorBrush x:Key="AccentSoftTextBrush">#c8d0df</SolidColorBrush>
        <SolidColorBrush x:Key="SearchBackgroundBrush">#080b10</SolidColorBrush>
        <SolidColorBrush x:Key="SearchControlBrush">#0d1219</SolidColorBrush>
        <SolidColorBrush x:Key="SearchControlBorderBrush">#1a2030</SolidColorBrush>
        <SolidColorBrush x:Key="SearchMutedBrush">#7a8ca8</SolidColorBrush>
        <SolidColorBrush x:Key="SearchIconBrush">#3a4255</SolidColorBrush>
        <SolidColorBrush x:Key="SearchRegisterBrush">#1544a8</SolidColorBrush>
        <SolidColorBrush x:Key="SearchRegisterHoverBrush">#1a52c8</SolidColorBrush>
        <SolidColorBrush x:Key="SearchRegisterTextBrush">#c8dcff</SolidColorBrush>
        <SolidColorBrush x:Key="ImageBadgeBackgroundBrush">#B30C121C</SolidColorBrush>
        <SolidColorBrush x:Key="ImageBadgeBorderBrush">#14FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="ImageBadgeTextBrush">#dde3ed</SolidColorBrush>
        <SolidColorBrush x:Key="WorkspaceViewportBrush">#080b10</SolidColorBrush>
        <SolidColorBrush x:Key="WorkspaceBoardBrush">#0d1219</SolidColorBrush>
        <SolidColorBrush x:Key="WorkspaceBoardBorderBrush">#1a2030</SolidColorBrush>
        <SolidColorBrush x:Key="OverlayBrush">#99000000</SolidColorBrush>
        <SolidColorBrush x:Key="OverlayCardBrush">#f0121824</SolidColorBrush>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Button.btn">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"
                                          Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Button.btn-primary">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="#fff" />
        </Style>
        <Style Selector="Button.btn-primary:pointerover">
            <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}" />
        </Style>

        <Style Selector="Button.btn-success">
            <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
            <Setter Property="Foreground" Value="#fff" />
        </Style>
        <Style Selector="Button.btn-success:pointerover">
            <Setter Property="Background" Value="{DynamicResource SuccessHoverBrush}" />
        </Style>
        <Style Selector="Button.btn-success:disabled">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
        </Style>

        <Style Selector="Button.btn-danger">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
            <Setter Property="Foreground" Value="#fff" />
        </Style>
        <Style Selector="Button.btn-danger:pointerover">
            <Setter Property="Background" Value="{DynamicResource DangerHoverBrush}" />
        </Style>

        <Style Selector="TextBox.field">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryBrush}" />
        </Style>
        <Style Selector="TextBox.field:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
        </Style>
        <Style Selector="TextBox.field /template/ Border#PART_BorderElement">
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </Application.Styles>
</Application>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:vm="using:Organizer.Application.ViewModels"
             xmlns:components="using:Organizer.Application.Components"
             x:Class="Organizer.Application.Views.EditView"
             x:DataType="vm:EditViewModel">

    <UserControl.Styles>

        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style Selector="ic|FluentIcon.section-icon">
            <Setter Property="IconVariant" Value="Regular" />
            <Setter Property="IconSize" Value="Size20" />
            <Setter Property="Foreground" Value="{DynamicResource AccentSoftTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="StackPanel.section-heading">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Spacing" Value="8" />
        </Style>

        <Style Selector="Border.section-card">
            <Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FloatingBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
        </Style>

        <Style Selector="StackPanel.page-shell">
            <Setter Property="Margin" Value="28" />
            <Setter Property="Spacing" Value="16" />
            <Setter Property="MaxWidth" Value="860" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style Selector="Button.btn">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="20 0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>

        <Style Selector="TextBox.field">
            <Setter Property="Padding" Value="12 10" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style Selector="Button.btn-secondary">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Button.btn-secondary:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FloatingBorderBrush}" />
        </Style>

        <Style Selector="Button ic|FluentIcon">
            <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
        </Style>

    </UserControl.Styles>

    <Grid Background="{DynamicResource AppBackgroundBrush}"
          VerticalAlignment="Stretch"
          HorizontalAlignment="Stretch">

        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel Classes="page-shell">

                <Border Classes="section-card">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="16">
                        <StackPanel Grid.Column="0"
                                    Spacing="4">
                            <TextBlock Text="{Binding Title}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding Subtitle}"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Classes="btn btn-secondary"
                                Height="40"
                                Padding="14 0"
                                VerticalAlignment="Top"
                                Command="{Binding CloseCommand}">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8">
                                <ic:FluentIcon Icon="Dismiss"
                                               IconVariant="Regular"
                                               IconSize="Size20"
                                               VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Loc.Common.Close}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Border Classes="section-card">
                    <StackPanel Spacing="18">
                        <StackPanel Classes="section-heading">
                            <ic:FluentIcon Classes="section-icon"
                                           Icon="DocumentText" />
                            <TextBlock Classes="section-title"
                                       Text="{DynamicResource Loc.Register.Info}" />
                        </StackPanel>

                        <StackPanel Spacing="12">
                            <StackPanel Classes="section-heading">
                                <ic:FluentIcon Classes="section-icon"
                                               Icon="TextDescription" />
                                <TextBlock Classes="section-title"
                                           Text="{DynamicResource Loc.Register.Description}" />
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Loc.Edit.DescriptionHint}"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap" />
                            <TextBox Classes="field"
                                     Text="{Binding Description}"
                                     PlaceholderText="{DynamicResource Loc.Edit.DescriptionPlaceholder}" />
                        </StackPanel>

                        <StackPanel Spacing="12">
                            <StackPanel Classes="section-heading">
                                <ic:FluentIcon Classes="section-icon"
                                               Icon="Tag" />
                                <TextBlock Classes="section-title"
                                           Text="{DynamicResource Loc.Register.Tags}" />
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Loc.Edit.TagsHint}"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap" />

                            <TextBlock IsVisible="{Binding !TagsLoaded}"
                                       Text="{DynamicResource Loc.Register.LoadingTags}"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextMutedBrush}" />

                            <components:TagSelector
                                x:Name="TagSelectorControl"
                                IsVisible="{Binding TagsLoaded}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="section-card">
                    <StackPanel Spacing="18">
                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrushColor}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14 12">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8">
                                <ic:FluentIcon IsVisible="{Binding StatusIsReady}"
                                               Icon="CheckmarkCircle"
                                               IconVariant="Regular"
                                               IconSize="Size20"
                                               Foreground="{DynamicResource SuccessTextBrush}"
                                               VerticalAlignment="Center" />
                                <ic:FluentIcon IsVisible="{Binding !StatusIsReady}"
                                               Icon="Warning"
                                               IconVariant="Regular"
                                               IconSize="Size20"
                                               Foreground="{DynamicResource WarningTextBrush}"
                                               VerticalAlignment="Center" />
                                <TextBlock Text="{Binding StatusText}"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border
                            IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Background="{DynamicResource DangerSoftBrush}"
                            BorderBrush="{DynamicResource DangerBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12 10">
                            <TextBlock Text="{Binding ErrorMessage}"
                                       FontSize="13"
                                       Foreground="{DynamicResource DangerSoftTextBrush}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <Button Classes="btn btn-success"
                                IsEnabled="{Binding IsReady}"
                                Command="{Binding SubmitCommand}"
                                HorizontalAlignment="Left"
                                MinWidth="180">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="10">
                                <ic:FluentIcon Icon="DocumentSave"
                                               IconVariant="Regular"
                                               IconSize="Size20"
                                               VerticalAlignment="Center" />
                                <TextBlock IsVisible="{Binding !IsSubmitting}"
                                           Text="{DynamicResource Loc.Edit.Save}"
                                           VerticalAlignment="Center" />
                                <TextBlock IsVisible="{Binding IsSubmitting}"
                                           Text="{DynamicResource Loc.Edit.Saving}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </Grid>

</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Organizer.Application.ViewModels"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="680"
             x:Class="Organizer.Organizer.Application.Views.PreferencesView"
             x:DataType="vm:PreferencesViewModel">

    <UserControl.Resources>
        <DataTemplate x:Key="PreferenceOptionTemplate"
                      x:CompileBindings="False">
            <TextBlock Text="{Binding Label}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       VerticalAlignment="Center" />
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.section-card">
            <Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FloatingBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="13" />
        </Style>

        <Style Selector="Border.section-head">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="0 0 0 1" />
            <Setter Property="Padding" Value="18 14 18 12" />
        </Style>

        <Style Selector="Border.preference-row">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="0 0 0 1" />
            <Setter Property="Padding" Value="18 13" />
        </Style>

        <Style Selector="Border.preference-row.last">
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="Border.preference-row:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>

        <Style Selector="Border.preference-tile">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="0 0 1 0" />
            <Setter Property="Padding" Value="18 13" />
        </Style>

        <Style Selector="Border.preference-tile.last">
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="Border.preference-tile:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>

        <Style Selector="ComboBox.preference-select">
            <Setter Property="MinWidth" Value="160" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10 0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="ComboBox.preference-select:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource FloatingBorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceSoftAltBrush}" />
        </Style>

        <Style Selector="ComboBox.preference-select:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
        </Style>

        <Style Selector="ComboBox.preference-select TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style Selector="ComboBox.preference-select ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        </Style>

        <Style Selector="ComboBox.preference-select ComboBoxItem:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>

        <Style Selector="ComboBox.preference-select ComboBoxItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>

        <Style Selector="TextBlock.section-title">
            <Setter Property="Foreground" Value="{DynamicResource AccentSoftTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="TextBlock.section-subtitle">
            <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="TextBlock.row-title">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="TextBlock.row-description">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="Button.settings-tab">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14 7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.settings-tab:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceSoftAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style Selector="Button.settings-tab.selected">
            <Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FloatingBorderBrush}" />
        </Style>

        <Style Selector="Button.settings-tab ic|FluentIcon">
            <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
        </Style>

        <Style Selector="Button.settings-tab.selected ic|FluentIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style Selector="Button.settings-tab.selected TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style Selector="Button.theme-option">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="11 6" />
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.theme-option:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceSoftAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style Selector="Button.theme-option.selected">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentSoftTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
        </Style>

        <Style Selector="Button.theme-option ic|FluentIcon">
            <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
        </Style>

        <Style Selector="Button.theme-option TextBlock">
            <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style Selector="StackPanel.section-heading ic|FluentIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
        </Style>

        <Style Selector="Slider">
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Slider:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        </Style>

        <Style Selector="ToggleSwitch">
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.backup-action">
            <Setter Property="MinHeight" Value="64" />
            <Setter Property="Padding" Value="14 11" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentSoftTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FloatingBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.backup-action:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentSoftTextBrush}" />
        </Style>

        <Style Selector="Button.backup-action.primary">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentSoftTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
        </Style>

        <Style Selector="Button.backup-action.danger">
            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DangerSoftTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
        </Style>

        <Style Selector="Button.backup-action:disabled">
            <Setter Property="Background" Value="{DynamicResource SurfaceSoftAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}" />
        </Style>

        <Style Selector="Button.backup-action ic|FluentIcon">
            <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
        </Style>

        <Style Selector="TextBlock.backup-action-title">
            <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="TextBlock.backup-action-desc">
            <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="Grid.backup-actions-grid">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style Selector="Border.backup-stat-cell">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="0 0 1 0" />
            <Setter Property="Padding" Value="18 14" />
        </Style>

        <Style Selector="Border.backup-stat-cell.last">
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="TextBlock.backup-stat-label">
            <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style Selector="TextBlock.backup-stat-value">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style Selector="Border.backup-field-row">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="0 0 0 1" />
            <Setter Property="Padding" Value="18 11" />
        </Style>

        <Style Selector="Border.backup-field-row.last">
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="TextBlock.backup-field-label">
            <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style Selector="Border.cloud-status-dot">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Border.cloud-status-dot.connected">
            <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
        </Style>

        <Style Selector="Border.cloud-status-dot.disconnected">
            <Setter Property="Background" Value="{DynamicResource TextSubtleBrush}" />
        </Style>

        <Style Selector="TextBlock.cloud-status-text.connected">
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
        </Style>

        <Style Selector="TextBlock.cloud-status-text.disconnected">
            <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
        </Style>

        <Style Selector="TextBlock.info-value">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="Border.about-hero">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="0 0 0 1" />
            <Setter Property="Padding" Value="22 20" />
        </Style>

        <Style Selector="Border.about-icon">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
        </Style>

        <Style Selector="Border.about-version-badge">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10 4" />
        </Style>

        <Style Selector="Border.about-stat-cell">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="0 0 1 1" />
            <Setter Property="Padding" Value="20 16" />
        </Style>

        <Style Selector="Border.about-stat-cell.last">
            <Setter Property="BorderThickness" Value="0 0 0 1" />
        </Style>

        <Style Selector="TextBlock.about-label">
            <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style Selector="TextBlock.about-stat-value">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LineHeight" Value="24" />
        </Style>

        <Style Selector="TextBlock.about-stat-sub">
            <Setter Property="Foreground" Value="{DynamicResource AccentSoftTextBrush}" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style Selector="Border.about-tech-section">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="0 0 0 1" />
            <Setter Property="Padding" Value="20 14" />
        </Style>

        <Style Selector="Border.about-chip">
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FloatingBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="11 5" />
        </Style>

        <Style Selector="Border.about-link">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="0 0 1 1" />
            <Setter Property="Padding" Value="18 13" />
        </Style>

        <Style Selector="Border.about-link.right">
            <Setter Property="BorderThickness" Value="0 0 0 1" />
        </Style>

        <Style Selector="Border.about-link.bottom">
            <Setter Property="BorderThickness" Value="0 0 1 0" />
        </Style>

        <Style Selector="Border.about-link.right.bottom">
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="TextBlock.about-link-title">
            <Setter Property="Foreground" Value="{DynamicResource AccentSoftTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="TextBlock.about-link-sub">
            <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="Border.autosave-hint">
            <Setter Property="Padding" Value="24 10" />
        </Style>
    </UserControl.Styles>

    <Grid Background="{DynamicResource AppBackgroundBrush}"
          RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Margin="24 20 24 0"
                    Spacing="3">
            <TextBlock Text="{DynamicResource Loc.Preferences.Title}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="15"
                       FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Loc.Preferences.Subtitle}"
                       Foreground="{DynamicResource TextSubtleBrush}"
                       FontSize="12" />
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Margin="24 14 24 0"
                    Orientation="Horizontal"
                    Spacing="4">
            <Button Classes="settings-tab"
                    Classes.selected="{Binding IsGeneralSelected}"
                    Click="OnGeneralSettingsClick">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <ic:FluentIcon Icon="Settings"
                                   IconVariant="Regular"
                                   IconSize="Size16" />
                    <TextBlock Text="{DynamicResource Loc.Preferences.TabSettings}" />
                </StackPanel>
            </Button>
            <Button Classes="settings-tab"
                    Classes.selected="{Binding IsDataBackupSelected}"
                    Click="OnDataBackupClick">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <ic:FluentIcon Icon="Database"
                                   IconVariant="Regular"
                                   IconSize="Size16" />
                    <TextBlock Text="{DynamicResource Loc.Preferences.TabDataBackup}" />
                </StackPanel>
            </Button>
            <Button Classes="settings-tab"
                    Classes.selected="{Binding IsAboutSelected}"
                    Click="OnAboutClick">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <ic:FluentIcon Icon="Info"
                                   IconVariant="Regular"
                                   IconSize="Size16" />
                    <TextBlock Text="{DynamicResource Loc.Preferences.TabAbout}" />
                </StackPanel>
            </Button>
        </StackPanel>

        <ScrollViewer Grid.Row="2"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Margin="0 16 0 0">
            <Grid Margin="24 0 24 28">
                <StackPanel IsVisible="{Binding IsGeneralSectionVisible}"
                            Spacing="12">
                    <Border Classes="section-card">
                        <StackPanel>
                            <Border Classes="section-head">
                                <StackPanel Classes="section-heading" Orientation="Horizontal" Spacing="10">
                                    <ic:FluentIcon Icon="Color"
                                                   IconVariant="Regular"
                                                   IconSize="Size16"
                                                   VerticalAlignment="Top" />
                                    <StackPanel Spacing="1">
                                        <TextBlock Classes="section-title" Text="{DynamicResource Loc.Preferences.Appearance}" />
                                        <TextBlock Classes="section-subtitle" Text="{DynamicResource Loc.Preferences.AppearanceDescription}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Classes="preference-row last">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="row-title" Text="{DynamicResource Loc.Preferences.Theme}" />
                                        <TextBlock Classes="row-description"
                                                   Text="{DynamicResource Loc.Preferences.ThemeDescription}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              Classes="preference-select"
                                              ItemsSource="{Binding ThemeOptions}"
                                              ItemTemplate="{StaticResource PreferenceOptionTemplate}"
                                              SelectedItem="{Binding SelectedTheme}"
                                              IsVisible="False" />
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="6">
                                        <Button Classes="theme-option"
                                                Classes.selected="{Binding IsSystemThemeSelected}"
                                                Click="OnSystemThemeClick">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <ic:FluentIcon Icon="Desktop"
                                                               IconVariant="Regular"
                                                               IconSize="Size16" />
                                                <TextBlock Text="{DynamicResource Loc.Preferences.Theme.System}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="theme-option"
                                                Classes.selected="{Binding IsDarkThemeSelected}"
                                                Click="OnDarkThemeClick">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <ic:FluentIcon Icon="WeatherMoon"
                                                               IconVariant="Regular"
                                                               IconSize="Size16" />
                                                <TextBlock Text="{DynamicResource Loc.Preferences.Theme.Dark}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="theme-option"
                                                Classes.selected="{Binding IsLightThemeSelected}"
                                                Click="OnLightThemeClick">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <ic:FluentIcon Icon="WeatherSunny"
                                                               IconVariant="Regular"
                                                               IconSize="Size16" />
                                                <TextBlock Text="{DynamicResource Loc.Preferences.Theme.Light}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="theme-option"
                                                Classes.selected="{Binding IsGrayThemeSelected}"
                                                Click="OnGrayThemeClick">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <ic:FluentIcon Icon="Grid"
                                                               IconVariant="Regular"
                                                               IconSize="Size16" />
                                                <TextBlock Text="{DynamicResource Loc.Preferences.Theme.Gray}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Classes="section-card">
                        <Grid ColumnDefinitions="*,*">
                            <Border Classes="preference-tile">
                                <StackPanel Spacing="10">
                                    <StackPanel Classes="section-heading" Orientation="Horizontal" Spacing="8">
                                        <ic:FluentIcon Icon="LocalLanguage"
                                                       IconVariant="Regular"
                                                       IconSize="Size16"
                                                       VerticalAlignment="Center" />
                                        <TextBlock Classes="section-title" Text="{DynamicResource Loc.Preferences.Language}" />
                                    </StackPanel>
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="row-title" Text="{DynamicResource Loc.Preferences.LanguageInterface}" />
                                        <TextBlock Classes="row-description"
                                                   Text="{DynamicResource Loc.Preferences.LanguageDescription}" />
                                    </StackPanel>
                                    <ComboBox Classes="preference-select"
                                              HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding LanguageOptions}"
                                              ItemTemplate="{StaticResource PreferenceOptionTemplate}"
                                              SelectedItem="{Binding SelectedLanguage}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    Classes="preference-tile last">
                                <StackPanel Spacing="10">
                                    <StackPanel Classes="section-heading" Orientation="Horizontal" Spacing="8">
                                        <ic:FluentIcon Icon="Shield"
                                                       IconVariant="Regular"
                                                       IconSize="Size16"
                                                       VerticalAlignment="Center" />
                                        <TextBlock Classes="section-title" Text="{DynamicResource Loc.Preferences.Security}" />
                                    </StackPanel>
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="row-title" Text="{DynamicResource Loc.Preferences.ConfirmDeletion}" />
                                        <TextBlock Classes="row-description"
                                                   Text="{DynamicResource Loc.Preferences.ConfirmDeletionDescription}" />
                                    </StackPanel>
                                    <ToggleSwitch IsChecked="{Binding ConfirmDeletion}"
                                                  HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Classes="section-card">
                        <StackPanel>
                            <Border Classes="section-head">
                                <StackPanel Classes="section-heading" Orientation="Horizontal" Spacing="10">
                                    <ic:FluentIcon Icon="Search"
                                                   IconVariant="Regular"
                                                   IconSize="Size16"
                                                   VerticalAlignment="Top" />
                                    <StackPanel Spacing="1">
                                        <TextBlock Classes="section-title" Text="{DynamicResource Loc.Preferences.Search}" />
                                        <TextBlock Classes="section-subtitle" Text="{DynamicResource Loc.Preferences.SearchDescription}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Classes="preference-row last">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="row-title" Text="{DynamicResource Loc.Preferences.ItemsPerPage}" />
                                        <TextBlock Classes="row-description"
                                                   Text="{DynamicResource Loc.Preferences.ItemsPerPageDescription}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              Classes="preference-select"
                                              ItemsSource="{Binding ItemsPerPageOptions}"
                                              ItemTemplate="{StaticResource PreferenceOptionTemplate}"
                                              SelectedItem="{Binding SelectedItemsPerPage}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Classes="section-card">
                        <StackPanel>
                            <Border Classes="section-head">
                                <StackPanel Classes="section-heading" Orientation="Horizontal" Spacing="10">
                                    <ic:FluentIcon Icon="Grid"
                                                   IconVariant="Regular"
                                                   IconSize="Size16"
                                                   VerticalAlignment="Top" />
                                    <StackPanel Spacing="1">
                                        <TextBlock Classes="section-title" Text="{DynamicResource Loc.Preferences.Workspace}" />
                                        <TextBlock Classes="section-subtitle"
                                                   Text="{DynamicResource Loc.Preferences.WorkspaceDescription}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Grid ColumnDefinitions="*,*"
                                  RowDefinitions="Auto,Auto">
                                <Border Classes="preference-tile">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                                        <StackPanel Spacing="3">
                                            <TextBlock Classes="row-title" Text="{DynamicResource Loc.Preferences.PasteMode}" />
                                            <TextBlock Classes="row-description"
                                                       Text="{DynamicResource Loc.Preferences.PasteModeDescription}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                  Classes="preference-select"
                                                  ItemsSource="{Binding WorkspacePasteOptions}"
                                                  ItemTemplate="{StaticResource PreferenceOptionTemplate}"
                                                  SelectedItem="{Binding SelectedWorkspacePasteMode}" />
                                    </Grid>
                                </Border>

                                <Border Grid.Column="1"
                                        Classes="preference-tile last">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                                        <StackPanel Spacing="3">
                                            <TextBlock Classes="row-title" Text="{DynamicResource Loc.Preferences.CanvasBackground}" />
                                            <TextBlock Classes="row-description"
                                                       Text="{DynamicResource Loc.Preferences.CanvasBackgroundDescription}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                  Classes="preference-select"
                                                  ItemsSource="{Binding WorkspaceBackgroundOptions}"
                                                  ItemTemplate="{StaticResource PreferenceOptionTemplate}"
                                                  SelectedItem="{Binding SelectedWorkspaceBackground}" />
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1"
                                        Classes="preference-tile">
                                    <Grid ColumnDefinitions="*,220" ColumnSpacing="18">
                                        <StackPanel Spacing="3">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Classes="row-title" Text="{DynamicResource Loc.Preferences.InitialZoom}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding WorkspaceDefaultZoomPercent, StringFormat='{}{0:0}%'}"
                                                           Foreground="{DynamicResource AccentSoftTextBrush}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Classes="row-description"
                                                       Text="{DynamicResource Loc.Preferences.InitialZoomDescription}" />
                                        </StackPanel>
                                        <Slider Grid.Column="1"
                                                Minimum="10"
                                                Maximum="200"
                                                TickFrequency="10"
                                                IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"
                                                Value="{Binding WorkspaceDefaultZoomPercent}" />
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1"
                                        Grid.Column="1"
                                        Classes="preference-tile last">
                                    <Grid ColumnDefinitions="*,220" ColumnSpacing="18">
                                        <StackPanel Spacing="3">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Classes="row-title" Text="{DynamicResource Loc.Preferences.HistoryLimit}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding WorkspaceHistoryLimit, StringFormat='{}{0:0}'}"
                                                           Foreground="{DynamicResource AccentSoftTextBrush}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Classes="row-description"
                                                       Text="{DynamicResource Loc.Preferences.HistoryLimitDescription}" />
                                        </StackPanel>
                                        <Slider Grid.Column="1"
                                                Minimum="0"
                                                Maximum="200"
                                                TickFrequency="10"
                                                IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"
                                                Value="{Binding WorkspaceHistoryLimit}" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel IsVisible="{Binding IsDataBackupSectionVisible}"
                            HorizontalAlignment="Stretch"
                            Spacing="12">
                    <Border Classes="section-card">
                        <StackPanel>
                            <Border Classes="section-head">
                                <StackPanel Classes="section-heading" Orientation="Horizontal" Spacing="10">
                                    <ic:FluentIcon Icon="Database"
                                                   IconVariant="Regular"
                                                   IconSize="Size16"
                                                   VerticalAlignment="Top" />
                                    <StackPanel Spacing="1">
                                        <TextBlock Classes="section-title" Text="{DynamicResource Loc.Backup.Database}" />
                                        <TextBlock Classes="section-subtitle"
                                                   Text="{DynamicResource Loc.Backup.DatabaseDescription}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Grid ColumnDefinitions="*,*,*">
                                <Border Classes="backup-stat-cell">
                                    <StackPanel Spacing="5">
                                        <TextBlock Classes="backup-stat-label" Text="{DynamicResource Loc.Backup.DatabaseSize}" />
                                        <TextBlock Classes="backup-stat-value" Text="{Binding DatabaseSize}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1"
                                        Classes="backup-stat-cell">
                                    <StackPanel Spacing="5">
                                        <TextBlock Classes="backup-stat-label" Text="{DynamicResource Loc.Backup.LastLocalBackup}" />
                                        <TextBlock Classes="backup-stat-value" Text="{Binding LastLocalBackup}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        Classes="backup-stat-cell last">
                                    <StackPanel Spacing="5">
                                        <TextBlock Classes="backup-stat-label" Text="{DynamicResource Loc.Backup.CurrentLocation}" />
                                        <TextBlock Classes="backup-stat-value"
                                                   FontFamily="monospace"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource AccentSoftTextBrush}"
                                                   Text="{Binding DatabaseLocation}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Classes="preference-row last">
                                <Grid Classes="backup-actions-grid"
                                      ColumnDefinitions="*,*"
                                      RowDefinitions="Auto,Auto"
                                      ColumnSpacing="8"
                                      RowSpacing="8">
                                    <Button Classes="backup-action primary"
                                            IsEnabled="{Binding IsNotBusy}"
                                            Click="OnCreateLocalBackupClick">
                                        <Grid ColumnDefinitions="Auto,*"
                                              ColumnSpacing="8">
                                            <ic:FluentIcon Icon="ArrowDownload"
                                                           IconVariant="Regular"
                                                           IconSize="Size16"
                                                           VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="1">
                                                <TextBlock Classes="backup-action-title" Text="{DynamicResource Loc.Backup.CreateLocalBackup}" />
                                                <TextBlock Classes="backup-action-desc" Text="{DynamicResource Loc.Backup.CreateLocalBackupDescription}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <Button Classes="backup-action"
                                            Grid.Column="1"
                                            IsEnabled="{Binding IsNotBusy}"
                                            Click="OnRestoreFromBackupClick">
                                        <Grid ColumnDefinitions="Auto,*"
                                              ColumnSpacing="8">
                                            <ic:FluentIcon Icon="ArrowUpload"
                                                           IconVariant="Regular"
                                                           IconSize="Size16"
                                                           VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="1">
                                                <TextBlock Classes="backup-action-title" Text="{DynamicResource Loc.Backup.RestoreFromBackup}" />
                                                <TextBlock Classes="backup-action-desc" Text="{DynamicResource Loc.Backup.RestoreFromBackupDescription}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <Button Classes="backup-action"
                                            Grid.Row="1"
                                            IsEnabled="{Binding IsNotBusy}"
                                            Click="OnExportDatabaseClick">
                                        <Grid ColumnDefinitions="Auto,*"
                                              ColumnSpacing="8">
                                            <ic:FluentIcon Icon="ArrowDownload"
                                                           IconVariant="Regular"
                                                           IconSize="Size16"
                                                           VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="1">
                                                <TextBlock Classes="backup-action-title" Text="{DynamicResource Loc.Backup.ExportDatabase}" />
                                                <TextBlock Classes="backup-action-desc" Text="{DynamicResource Loc.Backup.ExportDatabaseDescription}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <Button Classes="backup-action"
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            IsEnabled="{Binding IsNotBusy}"
                                            Click="OnImportDatabaseClick">
                                        <Grid ColumnDefinitions="Auto,*"
                                              ColumnSpacing="8">
                                            <ic:FluentIcon Icon="ArrowUpload"
                                                           IconVariant="Regular"
                                                           IconSize="Size16"
                                                           VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="1">
                                                <TextBlock Classes="backup-action-title" Text="{DynamicResource Loc.Backup.ImportDatabase}" />
                                                <TextBlock Classes="backup-action-desc" Text="{DynamicResource Loc.Backup.ImportDatabaseDescription}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Classes="section-card">
                        <StackPanel>
                            <Border Classes="section-head">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Classes="section-heading" Orientation="Horizontal" Spacing="10">
                                        <ic:FluentIcon Icon="Cloud"
                                                       IconVariant="Regular"
                                                       IconSize="Size16"
                                                       VerticalAlignment="Top" />
                                        <StackPanel Spacing="1">
                                            <TextBlock Classes="section-title" Text="{DynamicResource Loc.Backup.CloudBackup}" />
                                            <TextBlock Classes="section-subtitle"
                                                       Text="{DynamicResource Loc.Backup.CloudBackupDescription}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="6"
                                                VerticalAlignment="Center">
                                        <Border Classes="cloud-status-dot"
                                                Classes.connected="{Binding IsCloudConnected}"
                                                Classes.disconnected="{Binding IsCloudDisconnected}" />
                                        <TextBlock Text="{Binding CloudProviderStatus}"
                                                   Classes="cloud-status-text"
                                                   Classes.connected="{Binding IsCloudConnected}"
                                                   Classes.disconnected="{Binding IsCloudDisconnected}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <StackPanel>
                                <Border Classes="backup-field-row">
                                    <Grid ColumnDefinitions="140,*" ColumnSpacing="12">
                                        <TextBlock Classes="backup-field-label" Text="{DynamicResource Loc.Backup.Provider}" />
                                        <TextBlock Grid.Column="1"
                                                   Classes="info-value"
                                                   Text="{Binding CloudProviderName}" />
                                    </Grid>
                                </Border>
                                <Border Classes="backup-field-row">
                                    <Grid ColumnDefinitions="140,*" ColumnSpacing="12">
                                        <TextBlock Classes="backup-field-label" Text="{DynamicResource Loc.Backup.LastCloudBackup}" />
                                        <TextBlock Grid.Column="1"
                                                   Classes="info-value"
                                                   Text="{Binding LastCloudBackup}" />
                                    </Grid>
                                </Border>
                                <Border Classes="backup-field-row">
                                    <Grid ColumnDefinitions="140,*" ColumnSpacing="12">
                                        <TextBlock Classes="backup-field-label"
                                                   Text="{DynamicResource Loc.Backup.GoogleClientId}"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1"
                                                 Classes="field"
                                                 Text="{Binding GoogleDriveClientId, Mode=TwoWay}"
                                                 PlaceholderText="{DynamicResource Loc.Backup.GoogleClientIdWatermark}" />
                                    </Grid>
                                </Border>
                                <Border Classes="backup-field-row last">
                                    <Grid ColumnDefinitions="140,*" ColumnSpacing="12">
                                        <TextBlock Classes="backup-field-label"
                                                   Text="{DynamicResource Loc.Backup.GoogleClientSecret}"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1"
                                                 Classes="field"
                                                 Text="{Binding GoogleDriveClientSecret, Mode=TwoWay}"
                                                 PlaceholderText="{DynamicResource Loc.Backup.GoogleClientSecretWatermark}"
                                                 PasswordChar="*" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <Border Classes="preference-row last">
                                <Grid Classes="backup-actions-grid"
                                      ColumnDefinitions="*,*"
                                      RowDefinitions="Auto,Auto"
                                      ColumnSpacing="8"
                                      RowSpacing="8">
                                    <Button Classes="backup-action primary"
                                            IsEnabled="{Binding IsNotBusy}"
                                            Click="OnBackupToGoogleDriveClick">
                                        <Grid ColumnDefinitions="Auto,*"
                                              ColumnSpacing="8">
                                            <ic:FluentIcon Icon="Cloud"
                                                           IconVariant="Regular"
                                                           IconSize="Size16"
                                                           VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="1">
                                                <TextBlock Classes="backup-action-title" Text="{DynamicResource Loc.Backup.BackupToGoogleDrive}" />
                                                <TextBlock Classes="backup-action-desc" Text="{DynamicResource Loc.Backup.BackupToGoogleDriveDescription}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <Button Classes="backup-action"
                                            Grid.Column="1"
                                            IsEnabled="{Binding IsNotBusy}"
                                            Click="OnRestoreFromGoogleDriveClick">
                                        <Grid ColumnDefinitions="Auto,*"
                                              ColumnSpacing="8">
                                            <ic:FluentIcon Icon="Cloud"
                                                           IconVariant="Regular"
                                                           IconSize="Size16"
                                                           VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="1">
                                                <TextBlock Classes="backup-action-title" Text="{DynamicResource Loc.Backup.RestoreFromGoogleDrive}" />
                                                <TextBlock Classes="backup-action-desc" Text="{DynamicResource Loc.Backup.RestoreFromGoogleDriveDescription}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <Button Classes="backup-action"
                                            Grid.Row="1"
                                            IsEnabled="{Binding IsNotBusy}"
                                            Click="OnConnectGoogleDriveClick">
                                        <Grid ColumnDefinitions="Auto,*"
                                              ColumnSpacing="8">
                                            <ic:FluentIcon Icon="Cloud"
                                                           IconVariant="Regular"
                                                           IconSize="Size16"
                                                           VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="1">
                                                <TextBlock Classes="backup-action-title" Text="{DynamicResource Loc.Backup.ConnectGoogleDrive}" />
                                                <TextBlock Classes="backup-action-desc" Text="{DynamicResource Loc.Backup.ConnectGoogleDriveDescription}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <Button Classes="backup-action danger"
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            IsEnabled="{Binding IsNotBusy}"
                                            Click="OnDisconnectGoogleDriveClick">
                                        <Grid ColumnDefinitions="Auto,*"
                                              ColumnSpacing="8">
                                            <ic:FluentIcon Icon="Delete"
                                                           IconVariant="Regular"
                                                           IconSize="Size16"
                                                           VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="1">
                                                <TextBlock Classes="backup-action-title" Text="{DynamicResource Loc.Backup.DisconnectGoogleDrive}" />
                                                <TextBlock Classes="backup-action-desc" Text="{DynamicResource Loc.Backup.DisconnectGoogleDriveDescription}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Classes="section-card"
                        IsVisible="{Binding IsAboutSectionVisible}">
                    <StackPanel>
                        <Border Classes="about-hero">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                <Image Source="/Organizer.Application/Assets/Icons/organizer.png"
                                       Width="48"
                                       Height="48"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1"
                                            Spacing="3"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Organizer"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{DynamicResource Loc.Preferences.AboutDescription}"
                                               Foreground="{DynamicResource TextSubtleBrush}"
                                               FontSize="12"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            Spacing="4"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <Border Classes="about-version-badge"
                                            HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding AppVersion, StringFormat='v{0}'}"
                                                   Foreground="{DynamicResource PrimaryBrush}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Text="{Binding BuildNumber, StringFormat='build {0}'}"
                                               Foreground="{DynamicResource TextSubtleBrush}"
                                               FontFamily="monospace"
                                               FontSize="10"
                                               HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid ColumnDefinitions="*,*,*">
                            <Border Classes="about-stat-cell">
                                <StackPanel Spacing="5">
                                    <TextBlock Classes="about-label"
                                               Text="{DynamicResource Loc.Preferences.AboutImagesLabel}" />
                                    <TextBlock Classes="about-stat-value"
                                               Text="{Binding AboutImageCount}" />
                                    <TextBlock Classes="about-stat-sub"
                                               Text="{DynamicResource Loc.Preferences.AboutImagesSub}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    Classes="about-stat-cell">
                                <StackPanel Spacing="5">
                                    <TextBlock Classes="about-label"
                                               Text="{DynamicResource Loc.Preferences.AboutWorkspacesLabel}" />
                                    <TextBlock Classes="about-stat-value"
                                               Text="{Binding AboutWorkspaceCount}" />
                                    <TextBlock Classes="about-stat-sub"
                                               Text="{DynamicResource Loc.Preferences.AboutWorkspacesSub}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Classes="about-stat-cell last">
                                <StackPanel Spacing="5">
                                    <TextBlock Classes="about-label"
                                               Text="{DynamicResource Loc.Preferences.AboutTagsLabel}" />
                                    <TextBlock Classes="about-stat-value"
                                               Text="{Binding AboutTagCount}" />
                                    <TextBlock Classes="about-stat-sub"
                                               Text="{DynamicResource Loc.Preferences.AboutTagsSub}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Classes="about-tech-section">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="about-label"
                                           Text="{DynamicResource Loc.Preferences.AboutTechnology}" />
                                <WrapPanel>
                                    <Border Classes="about-chip"
                                            Margin="0 0 6 6">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <ic:FluentIcon Icon="Info"
                                                           IconVariant="Regular"
                                                           IconSize="Size16"
                                                           Foreground="{DynamicResource AccentSoftTextBrush}" />
                                            <TextBlock Text=".NET 10"
                                                       Foreground="{DynamicResource AccentSoftTextBrush}"
                                                       FontSize="11" />
                                        </StackPanel>
                                    </Border>
                                    <Border Classes="about-chip"
                                            Margin="0 0 6 6">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <ic:FluentIcon Icon="Grid"
                                                           IconVariant="Regular"
                                                           IconSize="Size16"
                                                           Foreground="{DynamicResource AccentSoftTextBrush}" />
                                            <TextBlock Text="Avalonia"
                                                       Foreground="{DynamicResource AccentSoftTextBrush}"
                                                       FontSize="11" />
                                        </StackPanel>
                                    </Border>
                                    <Border Classes="about-chip"
                                            Margin="0 0 6 6">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <ic:FluentIcon Icon="Database"
                                                           IconVariant="Regular"
                                                           IconSize="Size16"
                                                           Foreground="{DynamicResource AccentSoftTextBrush}" />
                                            <TextBlock Text="EF Core"
                                                       Foreground="{DynamicResource AccentSoftTextBrush}"
                                                       FontSize="11" />
                                        </StackPanel>
                                    </Border>
                                    <Border Classes="about-chip"
                                            Margin="0 0 6 6">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <ic:FluentIcon Icon="Database"
                                                           IconVariant="Regular"
                                                           IconSize="Size16"
                                                           Foreground="{DynamicResource AccentSoftTextBrush}" />
                                            <TextBlock Text="SQLite"
                                                       Foreground="{DynamicResource AccentSoftTextBrush}"
                                                       FontSize="11" />
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Grid ColumnDefinitions="*,*"
                              RowDefinitions="Auto,Auto">
                            <Border Classes="about-link">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <ic:FluentIcon Icon="Grid"
                                                   IconVariant="Regular"
                                                   IconSize="Size16"
                                                   Foreground="{DynamicResource TextSubtleBrush}"
                                                   VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Classes="about-link-title"
                                                   Text="{DynamicResource Loc.Preferences.AboutRepository}" />
                                        <TextBlock Classes="about-link-sub"
                                                   Text="{DynamicResource Loc.Preferences.AboutRepositorySub}" />
                                    </StackPanel>
                                    <ic:FluentIcon Grid.Column="2"
                                                   Icon="Info"
                                                   IconVariant="Regular"
                                                   IconSize="Size16"
                                                   Foreground="{DynamicResource TextSubtleBrush}"
                                                   VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Border Grid.Column="1"
                                    Classes="about-link right">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <ic:FluentIcon Icon="Info"
                                                   IconVariant="Regular"
                                                   IconSize="Size16"
                                                   Foreground="{DynamicResource TextSubtleBrush}"
                                                   VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Classes="about-link-title"
                                                   Text="{DynamicResource Loc.Preferences.AboutReportBug}" />
                                        <TextBlock Classes="about-link-sub"
                                                   Text="{DynamicResource Loc.Preferences.AboutReportBugSub}" />
                                    </StackPanel>
                                    <ic:FluentIcon Grid.Column="2"
                                                   Icon="Info"
                                                   IconVariant="Regular"
                                                   IconSize="Size16"
                                                   Foreground="{DynamicResource TextSubtleBrush}"
                                                   VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Border Grid.Row="1"
                                    Classes="about-link bottom">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <ic:FluentIcon Icon="Info"
                                                   IconVariant="Regular"
                                                   IconSize="Size16"
                                                   Foreground="{DynamicResource TextSubtleBrush}"
                                                   VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Classes="about-link-title"
                                                   Text="{DynamicResource Loc.Preferences.AboutLicense}" />
                                        <TextBlock Classes="about-link-sub"
                                                   Text="{DynamicResource Loc.Preferences.AboutLicenseSub}" />
                                    </StackPanel>
                                    <ic:FluentIcon Grid.Column="2"
                                                   Icon="Info"
                                                   IconVariant="Regular"
                                                   IconSize="Size16"
                                                   Foreground="{DynamicResource TextSubtleBrush}"
                                                   VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Border Grid.Row="1"
                                    Grid.Column="1"
                                    Classes="about-link right bottom">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <ic:FluentIcon Icon="Cloud"
                                                   IconVariant="Regular"
                                                   IconSize="Size16"
                                                   Foreground="{DynamicResource TextSubtleBrush}"
                                                   VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Classes="about-link-title"
                                                   Text="{DynamicResource Loc.Preferences.AboutUpdates}" />
                                        <TextBlock Classes="about-link-sub"
                                                   Text="{DynamicResource Loc.Preferences.AboutUpdatesSub}" />
                                    </StackPanel>
                                    <ic:FluentIcon Grid.Column="2"
                                                   Icon="Info"
                                                   IconVariant="Regular"
                                                   IconSize="Size16"
                                                   Foreground="{DynamicResource TextSubtleBrush}"
                                                   VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="3"
                Classes="autosave-hint">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="6"
                        Height="6"
                        Background="{DynamicResource SuccessBrush}"
                        CornerRadius="3"
                        VerticalAlignment="Center" />
                <TextBlock Text="{DynamicResource Loc.Common.SaveAuto}"
                           Foreground="{DynamicResource SuccessBrush}"
                           FontSize="11"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

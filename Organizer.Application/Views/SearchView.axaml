<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:vm="using:Organizer.Application.ViewModels"
             xmlns:cvm="using:Organizer.Application.ViewModels.Components"
             xmlns:components="using:Organizer.Application.Components"
             xmlns:views="using:Organizer.Application.Views"
             x:Class="Organizer.Application.Views.SearchView"
             x:DataType="vm:SearchViewModel">

    <UserControl.Styles>
        <Style Selector="Border.floating-panel">
            <Setter Property="Background" Value="{DynamicResource SearchControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SearchControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
        </Style>

        <Style Selector="Border.tags-shell">
            <Setter Property="Padding" Value="14 10 14 4" />
        </Style>

        <Style Selector="Border.pagination-shell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
            <Setter Property="Padding" Value="6 0" />
        </Style>

        <Style Selector="TextBlock.results-info">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource SearchMutedBrush}" />
        </Style>

        <Style Selector="ic|FluentIcon.empty-icon">
            <Setter Property="IconVariant" Value="Regular" />
            <Setter Property="IconSize" Value="Size48" />
            <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
        </Style>

        <Style Selector="ic|FluentIcon.loading-icon">
            <Setter Property="IconVariant" Value="Regular" />
            <Setter Property="IconSize" Value="Size32" />
            <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
        </Style>

        <Style Selector="StackPanel.status-panel">
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <Style Selector="Button.confirm-action">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="118" />
            <Setter Property="Padding" Value="18 0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.confirm-cancel">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style Selector="Button.confirm-cancel:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid Background="{DynamicResource SearchBackgroundBrush}">

        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto"
              RowSpacing="14"
              Margin="20 20 20 18"
              HorizontalAlignment="Stretch">

            <components:SearchBar
                DataContext="{Binding SearchBar}" />

            <Border Grid.Row="1"
                    Classes="floating-panel tags-shell"
                    HorizontalAlignment="Stretch">
                <components:TagSelector
                    DataContext="{Binding TagSelector}" />
            </Border>

            <Grid Grid.Row="2"
                  ColumnDefinitions="*,Auto">
                <TextBlock Classes="results-info"
                           Text="{Binding ResultSummary}"
                           VerticalAlignment="Center" />
            </Grid>

            <Grid Grid.Row="3">
                <StackPanel Classes="status-panel"
                            IsVisible="{Binding Results.IsLoading}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12">
                    <ic:FluentIcon Classes="loading-icon"
                                   Icon="ArrowClockwise"
                                   HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Loc.Common.Loading}"
                               FontSize="14"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel Classes="status-panel"
                            IsVisible="{Binding Results.IsEmpty}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12"
                            Margin="0 24 0 0">
                    <ic:FluentIcon Classes="empty-icon"
                                   Icon="ImageSearch"
                                   HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Loc.Search.EmptyTitle}"
                               FontSize="16"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Loc.Search.EmptySubtitle}"
                               FontSize="13"
                               Foreground="{DynamicResource TextSubtleBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <ScrollViewer IsVisible="{Binding !Results.IsEmpty}"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalAlignment="Center"
                              VerticalScrollBarVisibility="Auto">

                    <ItemsControl ItemsSource="{Binding Results.Cards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"
                                           ItemWidth="250"
                                           ItemHeight="280" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="cvm:CardItemViewModel">
                                <components:ImageContainer DataContext="{Binding}"
                                                           Margin="0 0 10 10" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="4"
                    Classes="floating-panel pagination-shell"
                    HorizontalAlignment="Center">

                <components:Pagination
                    DataContext="{Binding Pagination}"
                    HorizontalAlignment="Center" />

            </Border>

        </Grid>

        <components:ImagePreviewModal
            ZIndex="100"
            DataContext="{Binding Preview}" />

        <views:GroupCopyPickerModal
            ZIndex="100"
            DataContext="{Binding CopyPicker}" />

        <Border ZIndex="140"
                IsVisible="{Binding DeleteConfirmation.IsVisible}"
                Background="{DynamicResource OverlayBrush}">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="430"
                    Background="{DynamicResource OverlayCardBrush}"
                    BorderBrush="{DynamicResource FloatingBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="22"
                    BoxShadow="0 24 60 #99000000">
                <StackPanel Spacing="18">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding DeleteConfirmation.Title}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DeleteConfirmation.Message}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Background="{DynamicResource DangerSoftBrush}"
                            BorderBrush="{DynamicResource DangerBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12 10">
                        <TextBlock Text="{DynamicResource Loc.Search.DeleteWarning}"
                                   Foreground="{DynamicResource DangerSoftTextBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                    </Border>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="10">
                        <Button Classes="confirm-action confirm-cancel"
                                Command="{Binding DeleteConfirmation.CancelCommand}">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{DynamicResource Loc.Common.Cancel}" />
                        </Button>
                        <Button Classes="confirm-action btn btn-danger"
                                Command="{Binding DeleteConfirmation.ConfirmCommand}">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{DynamicResource Loc.Common.Delete}" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

    </Grid>

</UserControl>

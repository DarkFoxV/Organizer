<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:vm="using:Organizer.Application.ViewModels.Components"
             x:Class="Organizer.Application.Components.ImageContainer"
             x:DataType="vm:CardItemViewModel"
             Width="240">

    <UserControl.Styles>
        <Style Selector="Border.image-card">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Border.image-card:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
        </Style>

        <Style Selector="Border.thumb-wrap">
            <Setter Property="Height" Value="170" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style Selector="Border.type-badge">
            <Setter Property="Background" Value="{DynamicResource ImageBadgeBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ImageBadgeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8 4" />
        </Style>

        <Style Selector="TextBlock.card-title">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="LineHeight" Value="19" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxHeight" Value="40" />
        </Style>

        <Style Selector="TextBlock.card-meta">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>

        <Style Selector="Button.action-btn">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"
                                          Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Button.action-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style Selector="Button.action-btn.danger:pointerover">
            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DangerSoftTextBrush}" />
        </Style>

        <Style Selector="Button.action-btn ic|FluentIcon">
            <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
        </Style>
    </UserControl.Styles>

    <Border Classes="image-card"
            PointerReleased="OnCardPointerReleased">

        <Grid RowDefinitions="170,Auto">
            <Border Classes="thumb-wrap">
                <Border Background="{DynamicResource AppBackgroundBrush}"
                        CornerRadius="8"
                        ClipToBounds="True">
                    <Grid>
                    <Image Source="{Binding Thumbnail}"
                           Stretch="Uniform"
                           IsVisible="{Binding IsLoaded}" />

                    <Border IsVisible="{Binding !IsLoaded}"
                            Background="{DynamicResource SurfaceAltBrush}"
                            CornerRadius="8">
                        <ic:FluentIcon Icon="ImageSparkle"
                                       IconVariant="Regular"
                                       IconSize="Size32"
                                       Foreground="{DynamicResource TextSubtleBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                    </Border>
                    </Grid>
                </Border>
            </Border>

            <Border Classes="type-badge"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="10">
                <TextBlock Text="{Binding BadgeText}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ImageBadgeTextBrush}" />
            </Border>

            <Border Grid.Row="1"
                    Padding="14 12 14 14">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">
                        <TextBlock Classes="card-title"
                                   Text="{Binding Description}" />

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="2">
                            <Button Classes="action-btn danger"
                                    Command="{Binding DeleteCommand}"
                                    ToolTip.Tip="Deletar">
                                <ic:FluentIcon Icon="Delete"
                                               IconVariant="Regular"
                                               IconSize="Size20" />
                            </Button>

                            <Button Classes="action-btn"
                                    Click="OnCopyImage"
                                    ToolTip.Tip="Copiar imagem">
                                <ic:FluentIcon Icon="Copy"
                                               IconVariant="Regular"
                                               IconSize="Size20" />
                            </Button>

                            <Button Classes="action-btn"
                                    Command="{Binding EditCommand}"
                                    ToolTip.Tip="Editar">
                                <ic:FluentIcon Icon="Edit"
                                               IconVariant="Regular"
                                               IconSize="Size20" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="card-meta"
                                   Text="{Binding CreatedAt}" />
                        <TextBlock Grid.Column="1"
                                   Classes="card-meta"
                                   Text="{Binding MetaText}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

    </Border>

</UserControl>
